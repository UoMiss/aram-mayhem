{
  "name": "aram-mayhem",
  "version": "0.1.3-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check": "pnpm run check:baseline && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "tauri": "tauri",
    "assets:champions:sync": "node scripts/sync-champion-assets.mjs",
    "assets:champions:update": "node scripts/sync-champion-assets.mjs --latest --refresh"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas-pro": "2.5.0",
    "pinia": "^3.0.3",
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.16.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.0"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "minimatch": "11.0.3",
      "js-beautify>glob": "14.0.2"
    }
  }
}
